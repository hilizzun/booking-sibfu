#!/bin/sh
# commit-msg: формат сообщения коммита
# Тема: <тип>(<слой>): <описание>. Тип обязателен, слой опционален.
# Тип выбирает раздел changelog: feat → Новое, fix → Исправления,
# docs → Документация; refactor/test/chore/ci в changelog не попадают.

MSG_FILE="$1"
MSG=$(head -n1 "$MSG_FILE" | tr -d '\r')

TYPES="feat|fix|docs|refactor|test|chore|ci"
LAYERS="contract|server|web|e2e|docs|adr"

if ! printf '%s' "$MSG" | grep -Eq "^(${TYPES})(\((${LAYERS})\))?: .+"; then
  echo "" >&2
  echo "Ошибка формата сообщения коммита." >&2
  echo "Ожидаем:  <тип>(<слой>): <описание>" >&2
  echo "Типы:     feat, fix, docs, refactor, test, chore, ci" >&2
  echo "Слои:     contract, server, web, e2e, docs, adr (необязательны)" >&2
  echo "Примеры:  feat(server): добавить вычисление слотов" >&2
  echo "          fix(web): поправить показ поясов" >&2
  echo "          docs: описать сценарий С2" >&2
  echo "Текущее:  $MSG" >&2
  exit 1
fi

# Длина темы: не больше 72 символов (считаем в символах, не в байтах:
# кириллица занимает 2 байта в UTF-8, лимит 72 байта резал бы её на ~36).
# wc -m есть и в Git for Windows (MSYS), и в Linux/macOS.
LEN=$(printf '%s' "$MSG" | wc -m | tr -d ' ')
if [ "$LEN" -gt 72 ]; then
  echo "" >&2
  echo "Тема коммита длинее 72 символов ($LEN). Сократите." >&2
  exit 1
fi

exit 0
