{
  "name": "booking-sibfu",
  "version": "1.0.0",
  "private": true,
  "description": "Сервис самостоятельной записи на созвоны и встречи (СФУ). Design First: сначала контракт, потом код.",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "contract",
    "server",
    "web"
  ],
  "scripts": {
    "contract:build": "npm run build --workspace contract",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "seed": "npm run seed --workspace server",
    "changelog": "node scripts/run-changelog.js",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "test": "npm run test --workspace server",
    "test:e2e": "playwright test --config e2e/playwright.config.mjs",
    "test:e2e:install": "playwright install chromium",
    "start:server:e2e": "npm run start --workspace server",
    "preview:web:e2e": "npm run preview:e2e --workspace web"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0"
  }
}
